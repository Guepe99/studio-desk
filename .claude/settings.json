{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(.venv/bin/*)",
      "Bash(pip *)",
      "Bash(pytest *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(az *)",
      "Bash(docker *)",
      "Bash(flock *)",
      "Bash(scripts/*)",
      "Bash(sqlite3 *)",
      "Bash(du *)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(az * delete *)",
      "Bash(gh repo delete *)",
      "Bash(git push --force *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
